local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")

local LocalPlayer = Players.LocalPlayer
local PREFIX = "!"

local function getCharacter()
    return LocalPlayer.Character
end

local function getRoot(character)
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function fling()
    local character = getCharacter()
    local root = getRoot(character)

    if not root then
        return
    end

    root.AssemblyLinearVelocity = Vector3.new(
        math.random(-150, 150),
        200,
        math.random(-150, 150)
    )
end

local function kill()
    local character = getCharacter()
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid.Health = 0
    end
end

local function bring(controller)
    if not controller then
        return
    end

    local myCharacter = getCharacter()
    local myRoot = getRoot(myCharacter)

    local controllerCharacter = controller.Character
    local controllerRoot = getRoot(controllerCharacter)

    if not myRoot or not controllerRoot then
        return
    end

    myRoot.CFrame = controllerRoot.CFrame * CFrame.new(0, 0, -3)
end

local function kick(reason)
    if not reason or reason == "" then
        reason = "You got kicked by the controller 😭"
    end

    LocalPlayer:Kick(reason)
end

local function say(message)
    if not message or message == "" then
        return
    end

    local channels = TextChatService:FindFirstChild("TextChannels")

    if not channels then
        return
    end

    local general = channels:FindFirstChild("RBXGeneral")

    if general then
        general:SendAsync(message)
    end
end

local function executeCommand(sender, text)
    if not sender then
        return
    end

    if type(text) ~= "string" then
        return
    end

    if text:sub(1, #PREFIX) ~= PREFIX then
        return
    end

    local command = text:sub(#PREFIX + 1)
    local lowerCommand = command:lower()

    if lowerCommand == "fling" then
        fling()

    elseif lowerCommand == "kill" then
        kill()

    elseif lowerCommand == "bring" then
        bring(sender)

    elseif lowerCommand == "kick" then
        kick("You got kicked by the controller 😭")

    elseif lowerCommand:sub(1, 5) == "kick " then
        local reason = command:sub(6)
        kick(reason)

    elseif lowerCommand:sub(1, 4) == "say " then
        local message = command:sub(5)
        say(message)
    end
end

TextChatService.MessageReceived:Connect(function(message)
    local textSource = message.TextSource

    if not textSource then
        return
    end

    local sender = Players:GetPlayerByUserId(textSource.UserId)

    if not sender then
        return
    end

    executeCommand(sender, message.Text)
end)

TextChatService.OnIncomingMessage = function(message)
    local textSource = message.TextSource

    if not textSource then
        return nil
    end

    local text = message.Text

    if type(text) ~= "string" then
        return nil
    end

    if text:sub(1, #PREFIX) ~= PREFIX then
        return nil
    end

    local properties = Instance.new("TextChatMessageProperties")
    properties.TextTransparency = 1

    return properties
end
